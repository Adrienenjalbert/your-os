{
  "name": "@your-os/example-minimal",
  "version": "0.0.0",
  "private": true,
  "description": "Bare-minimum code-mode tenant. CI integration test for @your-os/* packages.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node ./scripts/build-static.mjs",
    "dev": "echo 'example-minimal: tsc --watch'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "clean": "rimraf dist out"
  },
  "dependencies": {
    "@your-os/agent-context": "workspace:*",
    "@your-os/analytics": "workspace:*",
    "@your-os/brand-lint": "workspace:*",
    "@your-os/cli": "workspace:*",
    "@your-os/content-source": "workspace:*",
    "@your-os/content-types": "workspace:*",
    "@your-os/core": "workspace:*",
    "@your-os/pseo-engine": "workspace:*",
    "@your-os/seo": "workspace:*",
    "@your-os/skills": "workspace:*",
    "@your-os/tenant-config": "workspace:*",
    "@your-os/tools-engine": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@your-os/typescript-config": "workspace:*",
    "react": "^19.2.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}

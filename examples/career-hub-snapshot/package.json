    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@your-os/brand-lint": "workspace:*",
    "@your-os/tenant-config": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@your-os/typescript-config": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}

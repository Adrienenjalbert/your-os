{
  "name": "@your-os/example-career-hub-snapshot",
  "version": "0.0.0",
  "private": true,
  "description": "Byte-equivalence harness for Career Hub extractions. Pins fixtures so CI can assert no behavior drift.",
  "type": "module",
  "exports": {
    "./tenant.config": "./tenant.config.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "echo 'career-hub-snapshot: import-time validation only'",

{
  "name": "@your-os/strapi-codegen",
  "version": "0.0.0",
  "private": true,
  "description": "Introspects a Strapi instance's schema → generates TypeScript types + Zod runtime schemas for StrapiContentSource.",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "biome check src",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@your-os/strapi-template": "workspace:*"
  },
  "devDependencies": {
    "@your-os/typescript-config": "workspace:*",
    "@types/node": "^20.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "rimraf": "^6.0.1",
    "@biomejs/biome": "^1.9.4"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "bin": {
    "your-os-strapi-codegen": "dist/cli.js"
  },
  "yourOs": {
    "layer": "strapi",
    "stability": "beta"
  }
}

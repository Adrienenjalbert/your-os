{
  "name": "@your-os/configurator",
  "version": "0.0.0",
  "private": true,
  "description": "AI-driven onboarding agent. Scaffolds tenant repos from a Discovery brief.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check src",
    "clean": "rimraf dist .next .turbo"
  },
  "dependencies": {
    "@your-os/cli": "workspace:*",
    "@your-os/strapi-deploy": "workspace:*",
    "@your-os/strapi-template": "workspace:*",
    "@your-os/tenant-config": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "@your-os/example-career-hub-snapshot": "workspace:*",
    "@your-os/typescript-config": "workspace:*",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
